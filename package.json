{
  "name": "@shiftgraph/generate",
  "version": "0.2.2",
  "description": "TypeScript types AND test fixtures from what an API was actually observed to return. Optionality earned, not assumed. Zero dependencies.",
  "keywords": [
    "typescript",
    "types",
    "codegen",
    "zod",
    "openapi",
    "mcp",
    "api",
    "schema",
    "contract"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./core/shape.js": "./core/shape.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cli.js",
    "core/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "bin": {
    "generate": "cli.js"
  },
  "scripts": {
    "smoke": "node smoke.mjs",
    "prepublishOnly": "node smoke.mjs"
  },
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiftgraph/observatory.git",
    "directory": "packages/generate"
  },
  "homepage": "https://github.com/shiftgraph/observatory",
  "bugs": {
    "url": "https://github.com/shiftgraph/observatory/issues"
  }
}
